{
    "compilerOptions": {
        "module": "commonjs",
        "noImplicitAny": false,
        "target": "es6",
        "moduleResolution": "node",
        "removeComments": false,
        "sourceMap": true,
        "skipLibCheck": true,
        "noLib": false,
        "declaration": true,
        "outDir": "dist",
        "rootDir": "src",
        "strict": true,
        "forceConsistentCasingInFileNames": true,
        "importHelpers": true,
        "types": []
        // enable this when it works with tslint, or we switch to prettier
        // "declarationMap": true
    },
    "exclude": [
        "node_modules/**",
        "src/*_test.ts",
        "dist"
    ],
    "include": [
        "src/**/*"
    ]
}